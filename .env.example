# Blue Line Configuration Environment Variables
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database (Default: SQLite inside instance directory)
DATABASE_URL=sqlite:///instance/blue_line.db

# Demo Mode (true/false)
# When true: simulated police notification, console fallback for emails, safe for evaluation
DEMO_MODE=true

# Emergency Detection Settings
IMPACT_THRESHOLD=25.0
EMERGENCY_COUNTDOWN=10

# Mail Configuration (optional in DEMO_MODE)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=noreply@blueline.local

# Default Seed Accounts
ADMIN_DEFAULT_EMAIL=admin@blueline.local
ADMIN_DEFAULT_PASSWORD=Admin@12345
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=Demo@12345
